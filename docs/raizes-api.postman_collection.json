        {
          "name": "Consultar Estoque da Unidade (Operacao)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOperacao}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/estoque/unidades/{{unidadeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "estoque",
                "unidades",
                "{{unidadeId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Pedidos e Pagamento",
      "item": [
        {
          "name": "Criar Pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": {{unidadeId}},\n  \"canalPedido\": \"APP\",\n  \"formaPagamento\": \"PIX\",\n  \"itens\": [\n    {\n      \"produtoId\": {{produtoId}},\n      \"quantidade\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Processar Pagamento Mock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"formaPagamento\": \"PIX\",\n  \"forcarAprovacao\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos/{{pedidoId}}/pagamento",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos",
                "{{pedidoId}}",
                "pagamento"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Listar Meus Pedidos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos/me?page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos",
                "me"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Atualizar Status do Pedido (Operacao)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOperacao}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"novoStatus\": \"EM_PREPARO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos/{{pedidoId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos",
                "{{pedidoId}}",
                "status"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Listar Pedidos Operacionais com Filtro",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOperacao}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos?status=AGUARDANDO_PAGAMENTO&unidadeId={{unidadeId}}&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pedidos"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "AGUARDANDO_PAGAMENTO"
                },
                {
                  "key": "unidadeId",
                  "value": "{{unidadeId}}"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
