                "v1",
                "catalogo",
                "produtos"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Listar Produtos por Categoria",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalogo/produtos?categoria=LANCHE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "catalogo",
                "produtos"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "LANCHE"
                }
              ]
            }
          },
          "response": []
